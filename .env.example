# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่า API key ของ Claude
# ขอ API key ได้ที่ https://platform.claude.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# รหัสผ่านร่วมสำหรับเข้าใช้งานเว็บ — ตั้งค่านี้เพื่อ "เปิดระบบล็อกอิน"
# ถ้าเว้นว่าง เว็บจะเปิดสาธารณะ (ใครมีลิงก์ก็เข้าใช้ได้) และจะขึ้นคำเตือน
APP_PASSWORD=

# (ไม่บังคับ) คีย์ลับสำหรับเซ็น session cookie
# ถ้าไม่ตั้ง ระบบจะสร้างคีย์จาก APP_PASSWORD ให้อัตโนมัติ
# SESSION_SECRET=

# พอร์ตที่ให้เว็บทำงาน (ไม่ใส่ก็ได้ ค่าเริ่มต้น 3000)
PORT=3000

# (เฉพาะตอนขึ้นออนไลน์) connection string ของ PostgreSQL เช่นจาก Neon
# ถ้าไม่ใส่ ระบบจะเก็บข้อมูลเป็นไฟล์ JSON ในเครื่อง (เหมาะกับรันในเครื่อง)
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# (ไม่บังคับ) PIN เจ้าของ — ตั้งแล้วการกระทำสำคัญต้องใส่ PIN ก่อน
# (แก้/ลบสินค้า, ยกเลิกรายการ, ปรับยอด/นับสต๊อก) พนักงานยังตัด/รับของได้ปกติ
# APP_ADMIN_PIN=

# (ไม่บังคับ) แจ้งเตือนของใกล้หมดผ่าน LINE วันละครั้ง (LINE Messaging API)
# 1) สร้าง channel ที่ developers.line.biz → Messaging API → ออก Channel access token
# 2) LINE_TO = userId ของคุณ (ดูได้ในหน้า channel: Your user ID) หรือ groupId
# 3) เพิ่มบอทเป็นเพื่อน/เข้ากลุ่มก่อน ถึงจะส่งหาได้
# LINE_CHANNEL_ACCESS_TOKEN=
# LINE_TO=
# ส่งหลังเวลานี้ของวัน (นาฬิกาไทย 0-23, ค่าเริ่มต้น 8 โมงเช้า)
# NOTIFY_HOUR=8

# (ไม่บังคับ) จำนวนรูปใบที่เก็บย้อนหลัง (เก่ากว่านี้ถูกล้างอัตโนมัติ กันฐานข้อมูลเต็ม)
# IMAGE_KEEP=400
