# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่า API key ของ Claude
# ขอ API key ได้ที่ https://platform.claude.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# พอร์ตที่ให้เว็บทำงาน (ไม่ใส่ก็ได้ ค่าเริ่มต้น 3000)
PORT=3000

# (เฉพาะตอนขึ้นออนไลน์) connection string ของ PostgreSQL เช่นจาก Neon
# ถ้าไม่ใส่ ระบบจะเก็บข้อมูลเป็นไฟล์ JSON ในเครื่อง (เหมาะกับรันในเครื่อง)
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
