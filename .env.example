# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่า API key ของ Claude
# ขอ API key ได้ที่ https://platform.claude.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# รหัสผ่านร่วมสำหรับเข้าใช้งานเว็บ — ตั้งค่านี้เพื่อ "เปิดระบบล็อกอิน"
# ถ้าเว้นว่าง เว็บจะเปิดสาธารณะ (ใครมีลิงก์ก็เข้าใช้ได้) และจะขึ้นคำเตือน
APP_PASSWORD=

# (ไม่บังคับ) คีย์ลับสำหรับเซ็น session cookie
# ถ้าไม่ตั้ง ระบบจะสร้างคีย์จาก APP_PASSWORD ให้อัตโนมัติ
# SESSION_SECRET=

# พอร์ตที่ให้เว็บทำงาน (ไม่ใส่ก็ได้ ค่าเริ่มต้น 3000)
PORT=3000

# (เฉพาะตอนขึ้นออนไลน์) connection string ของ PostgreSQL เช่นจาก Neon
# ถ้าไม่ใส่ ระบบจะเก็บข้อมูลเป็นไฟล์ JSON ในเครื่อง (เหมาะกับรันในเครื่อง)
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
